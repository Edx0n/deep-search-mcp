# deep-search-mcp: every variable is optional.
# Pass them through your MCP client's "env" block (Claude Desktop) or `claude mcp add -e NAME=value`.

# --- Tor (needed to READ .onion pages; dark web SEARCH works without it) ---
# Tor Browser: socks5h://127.0.0.1:9150   |   tor service / Expert Bundle: socks5h://127.0.0.1:9050
DEEP_SEARCH_TOR_PROXY=
# auto (onion mirror when Tor is set) | clearnet | onion
DEEP_SEARCH_AHMIA_MODE=auto
# User-Agent over Tor (default: Tor Browser's). Keep it in line with the current Tor Browser.
DEEP_SEARCH_TOR_USER_AGENT=

# --- Safety filter ---
# Non-locked categories to turn off: sexual, gore, violence_for_hire, weapons, drugs, fraud, hacking_services, extremism
# (csam, exploitation and mass_harm are locked and cannot be disabled)
DEEP_SEARCH_DISABLED_FILTERS=

# --- Optional API keys (all free tiers) ---
OPENALEX_API_KEY=
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
MARGINALIA_API_KEY=
BRAVE_API_KEY=

# Contact e-mail for the Crossref/OpenAlex "polite pool". Sent only if set.
DEEP_SEARCH_CONTACT_EMAIL=

# Timeouts in milliseconds
DEEP_SEARCH_TIMEOUT_MS=20000
DEEP_SEARCH_TOR_TIMEOUT_MS=60000
